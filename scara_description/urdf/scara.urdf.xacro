<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara">
    
    <!-- Load Simulated or Real Hardware Interfaces -->
    <xacro:arg name="is_sim" default="true"/>
    
    <!-- Include Gazebo Parameters -->
    <xacro:include filename="$(find scara_description)/urdf/scara_gazebo.xacro" />
    
    <!-- Include ros2_control Plugins -->
    <!-- <xacro:include filename="$(find scara_description)/urdf/scara_ros2_control.xacro" /> -->

    <!-- Materiais / Cores -->
    <material name="blue">
        <color rgba="0 0 0.8 1"/>
    </material>
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>
    <material name="yellow">
        <color rgba="1 1 0 1"/>
    </material>

    <!-- Useful XACRO Variables (Properties) -->
    <xacro:property name="PI" value="3.14159265359" />
    <xacro:property name="effort" value="30.0" />
    <xacro:property name="velocity" value="1.0" />

    <!-- Useful Macros -->
    <xacro:macro name="default_inertial" params="mass">
        <inertial> 
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${mass}" />
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="default_transmission" params="number">
        <transmission name="transmission_${number}">
            <plugin>transmission_interface/SimpleTransmission</plugin>
            <actuator name="motor_${number}" role="actuator1"/>
            <joint name="joint_${number}" role="joint1">
                <mechanical_reduction>1.0</mechanical_reduction>
            </joint>
        </transmission>
    </xacro:macro>

    <!-- Link WORLD -->
    <link name="world"/>

    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Link BASE_LINK -->
    <link name="base_link">
        <xacro:default_inertial mass="2.0"/>
        <visual>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="es_link">
        <xacro:default_inertial mass="0.5"/>
        <visual>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="as_link">
        <xacro:default_inertial mass="0.5"/>
        <visual>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="yellow"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="cs_link">
        <xacro:default_inertial mass="0.15"/>
        <visual>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="g1_gripper">
        <xacro:default_inertial mass="0.1"/>
        <visual>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="g2_gripper">
        <xacro:default_inertial mass="0.02"/>
        <visual>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>

    <link name="g3_gripper">
        <xacro:default_inertial mass="0.02"/>
        <visual>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="-0.5 -0.5 0"/>
            <geometry>
                <mesh filename="package://scara_description/meshes/bs.stl" scale="0.01 0.01 0.01"/>
            </geometry>
        </collision>
    </link>


</robot>